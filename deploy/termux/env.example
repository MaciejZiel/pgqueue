# Copy to ~/.config/pgqueue-demo/env and edit. Plain KEY=VALUE lines, read by start.sh.
# Never commit the edited copy.

# Database: its own role and database on the shared PostgreSQL (see setup-db.sh).
PGQUEUE_DSN=postgresql://pgqueue_demo:change-me@127.0.0.1:5432/pgqueue_demo
# The public dashboard connects with this one instead: a role that can only SELECT
# (created by setup-db.sh when DEMO_RO_PASSWORD is set). Unset = it uses PGQUEUE_DSN.
PGQUEUE_READONLY_DSN=postgresql://pgqueue_demo_ro:change-me-too@127.0.0.1:5432/pgqueue_demo

# Boot log (deploy/termux/boot/pgqueue-demo): rotated at this size, this many old files kept.
# PGQUEUE_LOG_MAX_BYTES=1048576
# PGQUEUE_LOG_KEEP=2

# Where the dashboard listens: loopback only, nginx is the public face.
DEMO_HOST=127.0.0.1
DEMO_PORT=8765
# The path nginx publishes it under (nginx strips it before proxying). Empty = served at "/".
DEMO_ROOT_PATH=/pgqueue

# Workload. These defaults are modest enough for a small home server.
DEMO_WORKERS=3
DEMO_CONCURRENCY=8
DEMO_RATE=8
DEMO_BURST_EVERY=45
DEMO_BURST_SIZE=240
DEMO_MAX_BACKLOG=1500
# A worker is SIGKILLed this often (seconds) to show lease recovery; 0 disables it.
DEMO_CRASH_EVERY=150

# Retention: finished jobs older than this, or beyond this many rows, are deleted.
DEMO_RETENTION_SECONDS=600
DEMO_MAX_FINISHED=6000
